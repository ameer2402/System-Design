// ======================================================
// PRODUCT INTERFACES
// ======================================================

interface Car {
    void drive();
}

interface Bike {
    void ride();
}

// ======================================================
// HONDA PRODUCTS
// ======================================================

class HondaCar implements Car {

    @Override
    public void drive() {
        System.out.println("Driving Honda Car");
    }
}

class HondaBike implements Bike {

    @Override
    public void ride() {
        System.out.println("Riding Honda Bike");
    }
}

// ======================================================
// TOYOTA PRODUCTS
// ======================================================

class ToyotaCar implements Car {

    @Override
    public void drive() {
        System.out.println("Driving Toyota Car");
    }
}

class ToyotaBike implements Bike {

    @Override
    public void ride() {
        System.out.println("Riding Toyota Bike");
    }
}

// ======================================================
// ABSTRACT FACTORY
// ======================================================

interface VehicleFactory {

    Car createCar();

    Bike createBike();
}

// ======================================================
// HONDA FACTORY
// ======================================================

class HondaFactory implements VehicleFactory {

    @Override
    public Car createCar() {
        return new HondaCar();
    }

    @Override
    public Bike createBike() {
        return new HondaBike();
    }
}

// ======================================================
// TOYOTA FACTORY
// ======================================================

class ToyotaFactory implements VehicleFactory {

    @Override
    public Car createCar() {
        return new ToyotaCar();
    }

    @Override
    public Bike createBike() {
        return new ToyotaBike();
    }
}

// ======================================================
// CLIENT
// ======================================================

public class Main {

    public static void main(String[] args) {

        // Honda Family
        VehicleFactory hondaFactory = new HondaFactory();

        Car hondaCar = hondaFactory.createCar();
        Bike hondaBike = hondaFactory.createBike();

        hondaCar.drive();
        hondaBike.ride();

        System.out.println("----------------");

        // Toyota Family
        VehicleFactory toyotaFactory = new ToyotaFactory();

        Car toyotaCar = toyotaFactory.createCar();
        Bike toyotaBike = toyotaFactory.createBike();

        toyotaCar.drive();
        toyotaBike.ride();
    }
}
